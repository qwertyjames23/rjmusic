# rjmusic.shop — environment variables
# Copy this file to .env.local and fill in your own values:
#   cp .env.local.example .env.local

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Dashboard → Product Environment)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Email allowed into the protected admin dashboard
ADMIN_EMAIL=

# Facebook Messenger Page access token (order status notifications)
PAGE_ACCESS_TOKEN=

# Google Generative AI API key (AI order bot / features)
GOOGLE_GENERATIVE_AI_API_KEY=
